# Identical complete development-branch Auth Base URL to web VITE_NEON_AUTH_URL.
# Owner fills ignored .env.local. Proof script loads it explicitly; other commands
# require the documented Node --env-file invocation. Never add real credentials here.
NEON_AUTH_BASE_URL=
# Exact frontend origin: HTTP loopback for development, otherwise HTTPS.
APP_ORIGIN=
# Pooled runtime and direct migration connections for the selected non-production branch.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Guarded local kendomenu_test only; never Neon or a development database.
TEST_DATABASE_URL=

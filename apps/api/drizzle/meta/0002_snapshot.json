        },
        "account_adoptions_acknowledged_revision_positive": {
          "name": "account_adoptions_acknowledged_revision_positive",
          "value": "(\"account_adoptions\".\"acknowledged_revision\" IS NULL OR \"account_adoptions\".\"acknowledged_revision\" > 0)"

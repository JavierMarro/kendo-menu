{
  "name": "@kendo-menu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test:persistence": "vitest run --config vitest.config.ts src/persistence",
    "test:integration": "tsx src/database/integration-command.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "tsx src/database/migrate-command.ts"
  },
  "dependencies": {
    "@elysia/node": "1.4.6",
    "@sinclair/typebox": "0.34.52",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.30",
    "exact-mirror": "0.2.7",
    "file-type": "22.0.2",
    "openapi-types": "12.1.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13"
  }
}

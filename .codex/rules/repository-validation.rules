# Allow only KendoMenu's repository-owned, non-interactive validation aliases.
prefix_rule(
    pattern = [
        "pnpm",
        [
            "build",
            "check",
            "check:domain",
            "check:store",
            "check:web",
            "format:check",
            "lint",
            "session:check",
            "test",
            "test:domain",
            "test:e2e",
            "test:e2e:a11y",
            "test:e2e:chromium",
            "test:e2e:mobile",
            "test:e2e:preview",
            "test:e2e:pwa",
            "test:store",
            "test:web",
            "typecheck",
            "verify:full",
        ],
    ],
    decision = "allow",
    justification = "These repository-owned aliases perform non-interactive local validation without changing dependencies, source files, Git history, or external systems.",
    match = [
        "pnpm build",
        "pnpm check",
        "pnpm check:domain",
        "pnpm check:store",
        "pnpm check:web",
        "pnpm format:check",
        "pnpm lint",
        "pnpm session:check",
        "pnpm test",
        "pnpm test:domain",
        "pnpm test:e2e",
        "pnpm test:e2e:a11y",
        "pnpm test:e2e:chromium",
        "pnpm test:e2e:mobile",
        "pnpm test:e2e:preview",
        "pnpm test:e2e:pwa",
        "pnpm test:store",
        "pnpm test:web",
        "pnpm typecheck",
        "pnpm verify:full",
    ],
    not_match = [
        "pnpm",
        "pnpm --filter @kendo-menu/web test",
        "pnpm add react",
        "pnpm dev",
        "pnpm exec playwright test",
        "pnpm format",
        "pnpm install",
        "pnpm publish",
        "pnpm remove react",
        "pnpm session:new -- --slug example --duration 1m",
        "pnpm update",
    ],
)

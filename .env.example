# Empty placeholders only. Backend commands inherit exported process variables.
# Vite does not load variables for the API. No command automatically reads env files.
# Runtime/development connection (not required for health).
DATABASE_URL=
# Direct connection used only by the explicit migration command.
MIGRATION_DATABASE_URL=
# Local kendomenu_test database only; required by test:api:integration.
TEST_DATABASE_URL=
# Google authorization-code OIDC; all four values are required for start/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Exact HTTPS application origin; callback must use this origin; also required for logout.
APP_ORIGIN=
